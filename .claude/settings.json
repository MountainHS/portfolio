{
  "enabledPlugins": {
    "portfolio-panel@portfolio-tools": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/subtitle-revise-reminder.py" },
          { "type": "command", "command": "python tools/voice-lint.py --hook" }
        ]
      }
    ]
  }
}
